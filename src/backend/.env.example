# GridGuard AI Backend Configuration
PROJECT_NAME="GridGuard AI"
VERSION="1.0.0"
API_PREFIX="/api"
DATABASE_URL="sqlite:///./gridguard.db"

# Risk Engine Thresholds
RISK_THRESHOLD_LOW=29
RISK_THRESHOLD_MODERATE=49
RISK_THRESHOLD_HIGH=69
RISK_THRESHOLD_VERY_HIGH=84
RISK_THRESHOLD_CRITICAL=85

# Risk Calculation Weights (must sum to 1.0)
WEIGHT_EQUIPMENT=0.40
WEIGHT_WEATHER=0.20
WEIGHT_IMPACT=0.25
WEIGHT_CRITICALITY=0.15

# ML Service Settings
USE_EXTERNAL_ML_SERVICE=false
EXTERNAL_ML_SERVICE_URL="http://localhost:8001/predict"

# CORS Configuration
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"
